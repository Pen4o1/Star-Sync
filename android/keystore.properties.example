# Copy this file to android/keystore.properties and fill in real values.
# Do NOT commit android/keystore.properties to source control.

# Debug keystore (optional overrides)
DEBUG_STORE_FILE=debug.keystore
DEBUG_STORE_PASSWORD=android
DEBUG_KEY_ALIAS=androiddebugkey
DEBUG_KEY_PASSWORD=android

# Release keystore
RELEASE_STORE_FILE=appiato.keystore
RELEASE_STORE_PASSWORD=Avi1to123
RELEASE_KEY_ALIAS=appiato
RELEASE_KEY_PASSWORD=Avi1to123
